{
  "name": "@fcode/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for fcode",
  "bin": {
    "fcode": "./dist/fcode.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/fcode.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/fcode-cli run build --filter=!@fcode/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@fcode/adapters": "workspace:*",
    "@fcode/bootstrap": "workspace:*",
    "@fcode/contracts": "workspace:*",
    "@fcode/core": "workspace:*",
    "@fcode/dynamic-workflow-runtime": "workspace:*",
    "@fcode/i18n": "workspace:*",
    "@fcode/provider-node": "workspace:*",
    "@fcode/shared": "workspace:*",
    "@fcode/shared-types": "workspace:*",
    "@fcode/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
